# Collivra Backend Configuration
# Copy this file to .env and fill in your Supabase project credentials

# Supabase PostgreSQL Pooler Connection (Port 6543)
DATABASE_URL=postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase Project API & Keys
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Runtime Feature Flags
DEV_MODE=true
SHOW_SEED_DATA=true
